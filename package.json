{
    "name": "shalinle",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22 <23"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "npm run lint:oxlint && npm run lint:eslint",
        "lint:oxlint": "oxlint .",
        "lint:eslint": "eslint .",
        "oxlint:generate": "npx --no-install @oxlint/migrate eslint.config.mjs --output-file .oxlintrc.json && node scripts/normalize-oxlint-config.mjs && oxfmt .oxlintrc.json",
        "oxlint:check": "npm run oxlint:generate && git diff --exit-code -- .oxlintrc.json",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "knip": "knip",
        "typecheck": "tsc --noEmit",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "oxfmt --write --no-error-on-unmatched-pattern",
        "*.{js,jsx,mjs,cjs,ts,tsx}": [
            "oxlint",
            "eslint"
        ]
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.18",
        "@radix-ui/react-slot": "^1.3.0",
        "@tanstack/react-query": "^5.85.5",
        "@types/d3": "^7.4.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "d3": "^7.9.0",
        "lucide-react": "^0.468.0",
        "next": "^15.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^2.5.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@oxlint/migrate": "^1.82.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.2",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.0",
        "eslint-plugin-oxlint": "^1.82.0",
        "husky": "^9.1.7",
        "knip": "^6.35.1",
        "lint-staged": "^17.5.1",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2"
    }
}
